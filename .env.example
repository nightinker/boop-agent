# ---- Convex ----
# Get these by running: npx convex dev
# Convex will create a project and auto-populate your .env.local.
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=
# Optional server-only override. Leave commented for local Vite dev; the server
# falls back to VITE_CONVEX_URL, and Convex CLI warns if both active URL vars exist.
# CONVEX_URL=

# ---- Sendblue (iMessage bridge) ----
# Sign up at https://sendblue.com, get your API keys + provisioned number.
# Webhook URL you'll set in Sendblue dashboard:  <PUBLIC_URL>/sendblue/webhook
#
# SENDBLUE_FROM_NUMBER MUST be your Sendblue-provisioned number (the one
# people text TO), not your personal cell. Sendblue's API requires it.
SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=
SENDBLUE_FROM_NUMBER=

# ---- Agent runtime ----
# claude = Claude Agent SDK / Claude Code path. codex = local `codex app-server`
# path using the ChatGPT/Codex account from `codex login`.
BOOP_RUNTIME=claude

# ---- Claude model ----
# Uses your Claude Code subscription automatically — no separate API key needed.
# Override with ANTHROPIC_API_KEY if you want to bypass the subscription.
# This is the *fallback*; runtime overrides set via the iMessage set_model tool
# (stored in the Convex `settings` table) take precedence.
BOOP_MODEL=claude-sonnet-5-5
# ANTHROPIC_API_KEY=

# ---- Codex model ----
# Used when BOOP_RUNTIME=codex or the runtime setting is switched to Codex.
# Requires `codex login` on the host. BOOP_CODEX_AUTH_HOME can point at another
# Codex home containing auth.json if needed.
BOOP_CODEX_MODEL=gpt-5.5
BOOP_CODEX_REASONING_EFFORT=medium
# BOOP_CODEX_AUTH_HOME=

# ---- Local browser use ----
# Patchright-backed Chrome profile for login-required services, visual browser
# workflows, and bot-wall-sensitive sites. Debug UI settings stored in Convex
# take precedence over these fallbacks. Off by default; enable in Settings
# before agents can see or use the local browser integration.
# macOS only: ignored (always off) when Boop runs on Linux, e.g. a VPS.
# BOOP_BROWSER_ENABLED=false
# BOOP_BROWSER_PROFILE_DIR=~/.boop/browser-profile
# BOOP_BROWSER_SHOW_UI=true
# BOOP_BROWSER_LOGIN_HANDOFF=false
# BOOP_BROWSER_START_URL=
# BOOP_BROWSER_CHANNEL=chrome
# BOOP_BROWSER_EXECUTABLE_PATH=
# BOOP_BROWSER_EXTRA_ARGS=

# ---- Apple data (optional) ----
# Read-only iMessage / Apple Notes / Apple Calendar / Apple Reminders access
# on the local Mac. iMessage requires Full Disk Access for the terminal/Codex
# app running `npm run dev`. Apple Notes and Apple Reminders require macOS
# Automation permission. Calendar requires the optional Apple bridge.
# macOS only: ignored (always off) when Boop runs on Linux, e.g. a VPS.
# BOOP_APPLE_ENABLED=false
# BOOP_APPLE_MESSAGES_ENABLED=false
# BOOP_APPLE_NOTES_ENABLED=false
# BOOP_APPLE_REMINDERS_ENABLED=false

# ---- Keep Mac awake ----
# Runs `caffeinate -dimsu` while Boop is the active copy so the Mac doesn't
# sleep. On by default; the Settings toggle overrides this. Ignored off macOS.
# Closing a MacBook's lid still sleeps it unless on AC with an external display.
# BOOP_KEEP_AWAKE=true

# ---- Proactive email surfacing ----
# Phone number that receives proactive iMessage notices when the Gmail watcher
# decides an inbound email is worth surfacing. Single-user assumption for v1.
# Without this, the webhook still registers but notices are dropped.
BOOP_USER_PHONE=
# Set to "false" to skip auto-registering the Composio webhook URL on each
# `npm run dev`. Use when you want to manage the subscription manually.
# COMPOSIO_AUTO_WEBHOOK=

# ---- Upgrade notifications ----
# On `npm run dev`, Boop checks your `upstream` remote for new commits and
# prints a banner with the commit count + a reminder to run `/upgrade-boop`.
# Set to `false` to silence the check entirely.
# BOOP_UPSTREAM_CHECK=true

# ---- Embeddings (optional — paid providers for memory recall) ----
# Tried in order: Voyage → OpenAI → local Transformers.js (Xenova/bge-large-
# en-v1.5, 1024-dim, free, ~440MB one-time download). Leave both blank to
# use the local fallback. All three produce 1024-dim vectors so the Convex
# index stays compatible regardless of which is active.
# VOYAGE_API_KEY=
# OPENAI_API_KEY=

# ---- Server ----
PORT=3456

# Public URL for your server.
# - Leave as http://localhost:3456 if you're using free ngrok (URL changes each restart).
# - Set to your stable public URL (e.g. https://boop.mydomain.com) if you use
#   Cloudflare Tunnel, a Caddy server, or any other tunnel with a fixed URL —
#   `npm run dev` will then skip ngrok.
PUBLIC_URL=http://localhost:3456

# Optional, for a server behind a Cloudflare Access login: visitors who passed
# it can use the dashboard at PUBLIC_URL (build it with `npm run dashboard:build`).
# See docs/DEPLOY-VPS.md → Using the dashboard.
# CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
# CF_ACCESS_AUD=

# Optional: enter secrets away from the Mac on a dedicated public host that
# serves ONLY the one-time secret entry pages (https only). Point a tunnel
# (ngrok reserved domain / cloudflared) at it, and set SECRETS_PORTAL_PASSCODE
# on the Mac via request_secret. See docs/SECRETS-REMOTE.md.
# SECRETS_PUBLIC_BASE_URL=https://secret.example.com
# SECRETS_PUBLIC_PORT=3457

# Running Boop on your Mac and a server at once: the online copy with the
# highest priority answers texts and runs automations (Mac 100, server 10 by
# default); the other stands by. See docs/DEPLOY-VPS.md.
# BOOP_INSTANCE_PRIORITY=
# BOOP_INSTANCE_LABEL=
# On a server: follow origin/main and restart when a build ships.
# BOOP_AUTO_UPDATE=true
# Also push the Convex functions when an update changes convex/ (needs `npx convex login`
# or CONVEX_DEPLOY_KEY for the boop user). Off by default; the Mac pushes them on start.
# BOOP_AUTO_UPDATE_CONVEX=true

# Claude account sync between your Mac and a server: the Mac shares which
# account it uses (publish), a server switches to its own login for it (follow).
# BOOP_ACCOUNT_SYNC=publish|follow|off

# Optional: ngrok RESERVED domain (paid plan). Example: "boop.ngrok.app".
# When set, `npm run dev` launches ngrok with --domain=$NGROK_DOMAIN so your
# public URL stays the same across restarts.
# NGROK_DOMAIN=

# When free-plan ngrok is in use, `npm run dev` auto-registers the new tunnel
# URL with Sendblue as the inbound (receive) webhook so you don't have to
# paste it into the dashboard. Set to "false" to disable this behavior.
# SENDBLUE_AUTO_WEBHOOK=true

# Sendblue occasionally accepts a text and never calls the webhook. Boop asks
# Sendblue for recent inbound texts this often and answers any it missed
# (already-answered texts are skipped). Set to 0 to turn the check off.
# SENDBLUE_POLL_INTERVAL_MS=60000
# Missed texts older than this are left alone, so a long outage doesn't
# answer a backlog of stale messages.
# SENDBLUE_POLL_LOOKBACK_MS=1800000

# Boop waits until you've been quiet this long (ms) before answering, so a
# burst of texts gets one combined reply. Each new text restarts the wait.
# While you're typing (iMessage only) Boop keeps waiting until you stop, then
# waits this long again. The Sendblue "typing_indicator" webhook is registered for you at
# <PUBLIC_URL>/sendblue/typing by `npm run sendblue:webhook` (run on every
# start). SMS/RCS texts keep the plain wait.
# Set to 0 to answer every text immediately.
# BOOP_MESSAGE_DEBOUNCE_MS=5000

# Hard cap on how long a burst of texts alone is held before answering (ms,
# counted from your first waiting text). Default 15000, at most 120000.
# BOOP_MESSAGE_MAX_HOLD_MS=15000

# Texts sent while Boop is still writing a reply (a long turn, a running
# sub-agent) are folded into it: the reply is held back unsent and redone so
# one answer covers everything, numbered oldest first, with later corrections
# winning. Work already done (sub-agent results, acks sent) is reused, not
# redone. Set to false to answer them separately instead (in parallel or
# queued, per maxConcurrentRuns).
# BOOP_MERGE_INFLIGHT_REPLIES=true

# Hard cap on the wait while you're typing (ms, counted from your first
# waiting text), so a lost "stopped typing" can't stall a reply. 60000 is the
# default, 120000 the most allowed. Texts alone are answered within
# BOOP_MESSAGE_MAX_HOLD_MS (15s by default).
# 0 ignores typing.
# BOOP_MAX_TYPING_HOLD_MS=60000

# A text sent while Boop is still answering an earlier one (a long turn, a
# running sub-agent) is queued and acked with "Got it, queued behind the
# current task (position N)". This is how long it waits before sending that
# ack (ms), so a reply that's about to land doesn't get one. 0 acks at once.
# BOOP_QUEUE_ACK_DELAY_MS=2000

# How many messages one conversation answers at once (1-5, default 2). A text
# that arrives while every slot is busy waits in the queue. 1 = one at a time.
# The maxConcurrentRuns setting (set_max_concurrent_runs) overrides this.
# BOOP_MAX_CONCURRENT_RUNS=2

# Set to false to skip registering the typing_indicator webhook.
# SENDBLUE_TYPING_WEBHOOK=true

# ---- Composio (1000+ integrations, zero-code) ----
# Get an API key at https://app.composio.dev/developers.
# Once set, connect toolkits (Gmail, Slack, GitHub, Linear, …) from the
# Debug UI's Connections tab. Each connected toolkit becomes available to
# the agent via spawn_agent(integrations: [...]).
COMPOSIO_API_KEY=

# Optional: stable user id Composio keys connections under. Defaults to
# "boop-default". Override only if you already manage Composio sessions
# elsewhere and want Boop to reuse that user.
# COMPOSIO_USER_ID=

# --- Image retention (optional) ---
# Days to keep iMessage-received image bytes. Images referenced by a
# memory record are kept indefinitely regardless of this setting.
# Set to 0 to disable cleanup (debug only).
BOOP_IMAGE_RETENTION_DAYS=3
BOOP_IMAGE_CLEANUP_INTERVAL_MS=43200000

# Self-build: text Boop "add <feature> to yourself" and it codes the change on a
# branch, runs the checks, opens a PR and texts you; reply "ship it" to merge,
# rebuild and restart (with automatic rollback if the new build doesn't start).
# BOOP_SOURCE_DIR is Boop's git checkout. BOOP_OWNER_NUMBERS lists the iMessage
# numbers allowed to ask (comma-separated, E.164); empty = nobody over iMessage.
# On a Linux server, set BOOP_SOURCE_DIR to its checkout to build and ship there
# while the Mac is off; the Mac installs main when it's back (docs/DEPLOY-VPS.md).
# BOOP_SOURCE_DIR=/Users/you/Sites/boop-agent
# BOOP_OWNER_NUMBERS=+15551234567
# BOOP_SELF_BUILD_MODEL=claude-opus-5-5
# Seconds a restarted build gets to answer /health before rolling back (default 180).
# Each restart's startup output is kept in ~/Library/Application Support/Boop/self-build/
# as startup-<buildId>-<attempt>.log (newest 10 kept).
# BOOP_SELF_BUILD_HEALTH_TIMEOUT=180

# Claude account switching: Boop finds Claude accounts signed in under
# ~/.claude and ~/.claude-<name> (sign in with `CLAUDE_CONFIG_DIR=~/.claude-<name> claude`),
# and the owner can switch with "which Claude accounts?" / "use my <name> Claude account".
# List extra config dirs elsewhere here (comma-separated). Holds paths only, never tokens.
# BOOP_CLAUDE_CONFIG_DIRS=/Users/you/claude-profiles/side
# Accounts managed by cswap (claude-swap) show up too, and "switch to <org or email>"
# runs `cswap switch`. Boop looks for cswap on PATH, ~/.local/bin, /opt/homebrew/bin and
# /usr/local/bin; set this only if it lives somewhere else. A path, never a token.
# BOOP_CSWAP_PATH=/Users/you/.local/bin/cswap

# Orchestrator's Hermes agent (orchestrator-go/README.md#hermes-agent): offered when `hermes` is installed.
# HERMES_BIN=
# ORCHESTRATOR_HERMES=off
# ORCHESTRATOR_HERMES_PROVIDER=claude-subscription-directsdk-experimental
# ORCHESTRATOR_HERMES_MODEL=sonnet
# ORCHESTRATOR_HERMES_TOOLSETS=browser,vision,web,terminal,file
# ORCHESTRATOR_HERMES_YOLO=off
# ORCHESTRATOR_HERMES_MAX_TURNS=60
# ORCHESTRATOR_HERMES_TIMEOUT=15m
